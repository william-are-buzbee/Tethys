# Tethys — .gitignore
# The game is built from shell.html + src/*.js by `node build.js` (or `python3 build.py`).
# Everything the build or the tests write is excluded here; the sources, docs and tests are tracked.

# --- build output (regenerated byte-for-byte by the build; do not edit by hand) ---
/tethys.html
/dev.html
/src/INDEX.md

# --- test output (`node test/preview.js` renders creature PNGs here) ---
/test/preview/
# the sound bench (src/bench.js) writes wavs and spectrograms here
/test/render/

# --- dependencies (none today: three.js loads from cdnjs; acorn is vendored in test/ on purpose and stays tracked) ---
node_modules/

# --- python bytecode (from build.py) ---
__pycache__/
*.pyc

# --- logs ---
*.log
logs/
npm-debug.log*

# --- local environment / secrets ---
.env
.env.*
!.env.example

# --- editor and tool state ---
.vscode/
.idea/
.claude/settings.local.json

# --- OS junk ---
Thumbs.db
desktop.ini
.DS_Store
